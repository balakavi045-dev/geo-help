{
  "name": "terra-geospatial-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --use-env-proxy --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --use-env-proxy server/index.mjs",
    "test": "node --use-env-proxy --test server/*.test.mjs",
    "data:prepare": "node --use-env-proxy scripts/prepare-data.mjs"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.18.3",
    "@turf/turf": "^7.3.4",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "searoute-js": "^0.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.51.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
